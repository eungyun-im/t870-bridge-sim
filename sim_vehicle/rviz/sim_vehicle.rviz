Panels:
- Class: rviz/Displays
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Odometry1
    Splitter Ratio: 0.5
  Tree Height: 600
- Class: rviz/Views
  Name: Views
  Splitter Ratio: 0.5
- Class: rviz/Time
  Name: Time
  SyncMode: 0
  SyncSource: ''
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 1
    Class: rviz/Grid
    Color: 160; 160; 164
    Enabled: true
    Name: Grid
    Normal Cell Count: 0
    Plane: XY
    Plane Cell Count: 50
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz/TF
    Enabled: true
    Name: TF
    Show Arrows: true
    Show Axes: true
    Show Names: true
    Value: true
  - Alpha: 1
    Buffer Length: 1
    Class: rviz/Path
    Color: 25; 255; 0
    Enabled: true
    Line Style: Lines
    Line Width: 0.05
    Name: Global Path
    Topic: /rviz_global_path
    Unreliable: false
    Value: true
  - Class: rviz/MarkerArray
    Enabled: true
    Marker Topic: /rviz_global_path_markers
    Name: Global Path (all csv)
    Namespaces: {}
    Queue Size: 100
    Value: true
  - Angle Tolerance: 0.1
    Class: rviz/Odometry
    Enabled: true
    Keep: 500
    Name: Sim Vehicle (odom_fused)
    Position Tolerance: 0.05
    Shape:
      Alpha: 1
      Axes Length: 1
      Axes Radius: 0.1
      Color: 255; 25; 0
      Head Length: 0.4
      Head Radius: 0.2
      Shaft Length: 0.6
      Shaft Radius: 0.1
      Value: Arrow
    Topic: /odom_fused
    Value: true
  - Class: rviz/Marker
    Enabled: true
    Marker Topic: /cur_pose
    Name: cur_pose
    Namespaces: {}
    Queue Size: 100
    Value: true
  - Class: rviz/Marker
    Enabled: true
    Marker Topic: /target_pose
    Name: target_pose
    Namespaces: {}
    Queue Size: 100
    Value: true
  - Circles color: 170; 0; 0
    Class: Obstacles
    Enabled: true
    Margin color: 0; 170; 0
    Name: Obstacles (obstacle_detector 원형 디스플레이)
    Opacity: 0.75
    Segments color: 170; 170; 0
    Segments thickness: 0.0299999993
    Topic: /obstacles
    Unreliable: false
    Value: true
  - Class: rviz/PoseArray
    Enabled: true
    Name: avoid_debug (map 변환 장애물)
    Topic: /avoid_debug
    Queue Size: 10
    Value: true
    Arrow Length: 0.5
    Color: 255; 170; 0
  - Class: rviz/MarkerArray
    Enabled: true
    Marker Topic: /avoid_markers
    Name: avoid_markers (레인 전환/복귀점)
    Namespaces: {}
    Queue Size: 100
    Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz/Interact
    Hide Inactive Objects: true
  - Class: rviz/MoveCamera
  - Class: rviz/Select
  Value: true
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Angle: 0
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 15
      Target Frame: <Fixed Frame>
      X: 0
      Y: 0
    Saved: []
Window Geometry:
  Displays:
    collapsed: false
  Height: 1016
  Views:
    collapsed: false
  Width: 1848
