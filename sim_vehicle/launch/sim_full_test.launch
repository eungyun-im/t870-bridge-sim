<?xml version="1.0"?>
<launch>
  <!-- 2026-09-08: S자 회피 + T자주차 + 평행주차 통합 테스트.
       실행:  roslaunch sim_vehicle sim_full_test.launch

       실차 노드 구성(parking_and_avoid.launch)을 그대로 include 하고
       라이다만 가짜로 바꾼다. 즉 검증 대상이 테스트용 복제본이 아니라
       실제로 차에서 도는 그 노드/파라미터다.
         lidar:=false     RPLIDAR/필터 안 띄움
         detector:=false  obstacle_extractor/tracker 안 띄움
                          (tracker 가 /obstacles 로 remap 돼 있어 가짜
                           라이다와 충돌한다)
       fake_obstacles_node 가 map 에 고정한 장애물을 laser 프레임으로
       바꿔 /obstacles 로 낸다. 소비 노드가 mount_*/odom 으로 다시 map 으로
       되돌리므로 실차와 같은 변환 경로를 탄다.

       시나리오 (mission_state 는 data_시흥 신 체계):
         state 7   S자   : 가운데(2.csv) 주행 중 좌/우 장애물을 반대쪽으로 회피
         state 12  T자   : 진입로에서 슬롯 A 후진경로(13) 막힘 -> 1.csv(B칸)
         state 18  직선  : 경로 정중앙 장애물 -> 정지 (stop_obstacle:=true 일 때)
         state 30  평행  : 진입로에서 슬롯 A 후진경로(31) 막힘 -> 1.csv(B칸)

       state 18 정지 장애물은 기본 꺼둔다. 켜면 거기서 멈춰 뒤쪽 주차까지
       가지 못한다. 정지만 따로 보려면 stop_obstacle:=true 로 실행. -->

  <arg name="start_rviz" default="false" />
  <!-- 2026-09-09: data_시흥/ 가 새 테스트 루프로 자주 덮여쓰이므로,
       원본 3-레인(용인) 코스를 다른 곳에 두고 골라 쓸 수 있게 한다.
       2026-09-17: 사용자가 data_시흥/ 최상위를 정리(백업)해서 실제 코스
       파일(0~7.csv)이 최종/ 하위로 옮겨졌다. sim 기본 경로도 그쪽으로. -->
  <arg name="csv_dir" default="$(find sim_vehicle)/../data_시흥/최종/" />

  <!-- 2026-09-08: 최고속 주행 / Ld 피팅용 속도 오버라이드.
       미션 switch 의 스테이트별 속도를 한 값으로 덮는다(raw 0~1000).
       0 이면 꺼짐 = 스테이트 테이블 그대로.
       raw 1000 = 15 km/h = 4.17 m/s (T870 최고속).
       정지 명령(신호등/장애물/주차진입)은 덮지 않는다.
       주차 구간은 parking_speed_override 로 따로 준다(후진 부호 유지). -->
  <arg name="speed_override"         default="0" />
  <arg name="parking_speed_override" default="0" />
  <!-- 2026-09-10: 기본값 false -> true. 배포 yaml 은 true 인데 여기가 false 라
       이 인자를 안 넘기면 yaml 을 덮어써서 "실차와 다른 설정"을 시험하게 됐다.
       그 상태에서는 적응형 Ld 분기를 안 타고 구 state 테이블의 값이 쓰이는데,
       용인 state 7(S자 헤어핀 R=3.77m)에 그 테이블은 Ld 7.5m 를 준다(원래
       data_시흥 체계의 "신호등 이후 가속" 항목이라 코스가 안 맞는다).
       실측: Ld 7.5 -> CTE 중앙 0.406 m / 최대 1.110 m,
             Ld 2.83(적응형) -> CTE 중앙 0.051 m / 최대 0.159 m (8배 차이).
       다른 인자들과 같은 규칙(기본값 = 배포값)으로 맞춘다. -->
  <arg name="lookahead_state_override" default="true" />
  <!-- 2026-09-09: 곡률 기반 속도 상한 오버라이드. 기본값은 t870_control.yaml
       에 이미 있는 배포값과 같게 둬서, 이 인자를 안 건드리면 동작이 그대로다.
       신구 비교 테스트할 때만 명시적으로 바꿔 쓴다(구 로직 성격으로 보려면
       speed_curvature_alat:=0 으로 꺼서 예전처럼 곡률 무시하게 만들 수 있다). -->
  <arg name="speed_curvature_alat" default="0.5" />
  <arg name="speed_curvature_preview" default="3.0" />
  <arg name="speed_curvature_min_raw" default="150" />
  <!-- 2026-09-09: CTE 반응형 감속. 곡률 preview 를 지연만큼 늘리는 사전예측
       보정(speed_curvature_lag_comp)은 실측상 효과가 없어 폐기(cmd_speed
       트레이스로 확인: 감속이 조향 포화 이후에나 걸림). 결과(cte)를 직접
       보고 깎는 이 방식이 sim 검증에서 구식 대비 전 percentile 개선 +
       최대 CTE 3.02->~2.0m 로 실효 있었다. gain 1.0 이 sim 검증값
       (완주시간 +8~9s, CTE 대폭 개선). 0=비활성. -->
  <arg name="speed_cte_gain" default="1.0" />
  <!-- 2026-09-17: true -> false. fake_vehicle_node.py 자체 기본값이 이미
       2026-09-14에 false 로 바뀌었다(EKF proc_stddev 상향으로 이 지연
       모델이 시뮬레이션하던 문제가 실제로 고쳐졌는데, 모델은 그 전
       데이터로 피팅된 채였다 - 켜두면 이미 고친 구간에서 sim CTE 만
       실차보다 부풀어 보인다). 이 launch 인자가 그 수정을 덮어쓰고
       있었다(실측: state15 sim maxCTE 1.0m vs 실차 0.6m 격차의 원인). -->
  <arg name="pos_lag_enable" default="false"
       doc="GPS 무관 EKF 지연 모델. 구 버전과 비교하려면 true." />
  <arg name="stop_obstacle" default="false"
       doc="true 면 state 18 경로 위에 장애물을 놓아 정지를 테스트한다(거기서 멈춤)" />

  <!-- 라이다 장착. 실차 런치 기본값과 같아야 map 왕복 변환이 맞는다. -->
  <arg name="mount_x"   default="1.079" />
  <arg name="mount_y"   default="0.0" />
  <arg name="mount_yaw" default="0.0" />

  <!-- map 좌표 [x, y, r, ...]
       S자 3개: 가운데 경로에서 횡 0.55m. 차선이 실제로 벌어진 arc 20~55m
                안에만 둔다(그 밖은 세 경로가 0.0~0.3m 로 붙어 피할 곳이 없다).
       T자   : 0.csv state 13(후진) 끝점 = 슬롯 A 중심
       평행  : 0.csv state 31(후진) 끝점 = 슬롯 A 중심

       2026-09-10: S자 장애물 반경 0.15 -> 0.40. 실제로 놓일 장애물이 같은
       T870 차량(폭 0.8 m)이라 0.15(폭 0.3 m)는 실제의 1/2.7 크기였다.
       통로폭 3.33 m 에 장애물 0.8 m + 자차 0.8 m 면 편측 여유가 0.23~0.46 m
       밖에 안 남으므로, 이 크기로 놓고 봐야 회피 성공 여부가 의미를 가진다.
       종전 난이도로 돌리려면 obstacles 인자를 직접 넘겨 0.15 로 쓴다. -->
  <arg name="obstacles"
       default="[-59.111, -33.082, 0.40,
                 -72.456, -30.034, 0.40,
                 -79.761, -21.633, 0.40,
                 -26.377, -50.005, 0.30,
                 -15.792, -25.541, 0.30]" />
  <arg name="obstacles_with_stop"
       default="[-59.111, -33.082, 0.15,
                 -72.456, -30.034, 0.15,
                 -79.761, -21.633, 0.15,
                 -26.377, -50.005, 0.30,
                 -15.792, -25.541, 0.30,
                 -68.490, -52.300, 0.20]" />

  <!-- 시뮬 차량 + 경로 로더.
       아래 param 은 waypoint_follower.launch 가 t870_control.yaml 을 읽은
       뒤에 와야 덮어쓸 수 있다. include 뒤에 두는 이유. -->
  <arg name="initial_lane" default="0" doc="0=0.csv 1=1.csv 단독주행" />
  <arg name="state_inspection" default="0"
       doc="로더 초기 mission_state. 코스 조각의 첫 state 값과 맞춰야 한다
            (예: 국민대 chunk2 는 4)." />
  <arg name="control_config"
       default="$(find waypoint_follower)/config/t870_control.yaml"
       doc="제어 파라미터 yaml. 사본을 넘겨 Ld 등을 구간별로 시험할 때 쓴다." />
  <arg name="min_final_ld" default="-1"
       doc="pure_pursuit final_ld 하한. -1 = 건드리지 않음(코드 기본 2.0)." />
  <arg name="init_from_csv" default="$(arg csv_dir)0.csv"
       doc="스폰 위치. 특정 구간만 빠르게 반복 테스트할 때 그 구간 시작점
            한 줄짜리 CSV 로 바꾸고 state_inspection 을 맞춰 쓴다." />
  <!-- 2026-09-10: 실차 parking_and_avoid.launch 는 이 TF 를 lidar:=true 일
       때만(RPLIDAR 그룹 안에서) 내는데, 우리 sim 은 항상 lidar:=false 라
       한 번도 발행된 적이 없었다. 그래서 /obstacles(frame=laser)를 RViz
       Obstacles 플러그인으로 map 기준에서 못 그렸다 — 우리 코드(toGlobal)는
       mount_x/y/yaw 를 직접 계산해 써서 상관없었지만, TF 트리가 비어
       있으니 시각화만 안 됐다. 실차와 같은 mount 값으로 그대로 채운다. -->
  <node name="base_link_to_laser" pkg="tf2_ros" type="static_transform_publisher"
        args="$(arg mount_x) $(arg mount_y) 0.0 $(arg mount_yaw) 0.0 0.0 base_link laser" />

  <include file="$(find sim_vehicle)/launch/sim_vehicle.launch">
    <arg name="start_rviz" value="$(arg start_rviz)" />
    <arg name="csv_dir" value="$(arg csv_dir)" />
    <arg name="pos_lag_enable" value="$(arg pos_lag_enable)" />
    <arg name="state_inspection" value="$(arg state_inspection)" />
    <arg name="initial_lane" value="$(arg initial_lane)" />
    <arg name="control_config" value="$(arg control_config)" />
    <arg name="min_final_ld" value="$(arg min_final_ld)" />
    <arg name="init_from_csv" value="$(arg init_from_csv)" />
  </include>
  <param name="/waypoint_follower_node/speed_override"
         value="$(arg speed_override)" />
  <param name="/waypoint_follower_node/parking_speed_override"
         value="$(arg parking_speed_override)" />
  <param name="/waypoint_follower_node/lookahead_state_override"
         value="$(arg lookahead_state_override)" />
  <param name="/waypoint_follower_node/speed_curvature_alat"
         value="$(arg speed_curvature_alat)" />
  <param name="/waypoint_follower_node/speed_curvature_preview"
         value="$(arg speed_curvature_preview)" />
  <param name="/waypoint_follower_node/speed_curvature_min_raw"
         value="$(arg speed_curvature_min_raw)" />
  <param name="/waypoint_follower_node/speed_cte_gain"
         value="$(arg speed_cte_gain)" />

  <!-- 가짜 라이다 -->
  <node name="fake_obstacles_node" pkg="sim_vehicle" type="fake_obstacles_node.py"
        output="screen">
    <rosparam unless="$(arg stop_obstacle)" param="obstacles"
              subst_value="True">$(arg obstacles)</rosparam>
    <rosparam if="$(arg stop_obstacle)" param="obstacles"
              subst_value="True">$(arg obstacles_with_stop)</rosparam>
    <param name="max_range" value="12.0" />
    <param name="odom_topic" value="/odom_back" />
    <param name="mount_x"   value="$(arg mount_x)" />
    <param name="mount_y"   value="$(arg mount_y)" />
    <param name="mount_yaw" value="$(arg mount_yaw)" />
  </node>

  <!-- 실차와 동일한 판정 노드 묶음 -->
  <!-- 2026-09-17: sim 이 실차(parking_and_avoid.launch) 기본값과 다른
       값(빈 ladder_lanes, ladder_csv_dir="", center_lane=2)을 명시적으로
       덮어쓰고 있어서, S자 회피 sim 검증이 여태 사다리 모드가 아니라
       구식 3차선(center/left/right, 무조건 외곽 점프) 모드로 돌고 있었다.
       실차가 이미 쓰는 전용 사다리 지오메트리 폴더 + center_lane=5 로
       맞춘다(sim 실측: state7 CTE 평균 0.099m/최대 1.072m, 3차선 모드
       대비 평균 9배 개선, 전환도 0->3->4->5 로 한 칸씩만 이동). -->
  <arg name="ladder_lanes" default="[0,3,4,5,6,7,1]"
       doc="S자 사다리. 실차와 동일 기본값. 3차선으로 되돌리려면 []." />
  <arg name="ladder_extra_step" default="0" />
  <arg name="ladder_csv_dir"
       default="$(find sim_vehicle)/../data_시흥/s자 드디어 찾았습니다"
       doc="비면 한 칸씩 방식. 주면 직접선택(전 레인 실시간 스캔) 모드.
            기본은 실차와 동일한 전용 폴더(state 4~15, 실측 기반)." />
  <arg name="ladder_state" default="7" />
  <arg name="ladder_safety_margin" default="0.15" />
  <!-- 2026-09-18: 평행주차 슬롯 판정 거리. p_parking_entry_dist 를 올리면
       (진입이 더 일찍 걸리면) 이 값보다 먼저 state31 로 넘어가버려서 슬롯
       A/B 결정이 아예 안 난다(실측: entry 3.5~5.5 에서 decided=-1 로 lane0
       고정). 반드시 entry 보다 크게 유지할 것. -->
  <arg name="p_decide_dist" default="6.5" />
  <!-- center_lane 은 사다리 배열 안의 값이어야 한다(밖이면 매 틱 무시되고
       배열 중앙 인덱스로 조용히 폴백한다 - 2026-09-10 최초 발견 당시의
       함정). 실차 기본값과 동일하게 5(사다리 안, state7 실제 기본
       주행선)로 맞춘다. -->
  <arg name="center_lane" default="5" />
  <arg name="left_lane"   default="0" />
  <arg name="right_lane"  default="1" />
  <!-- 2026-09-19: 실차 주차 판정은 /raw_obstacles(추출기 스캔별 검출)를 본다. sim 은 검출기를 안 띄우고
       가짜 라이다가 /obstacles 를 직접 내므로(예측 없는 원) 두 주차 노드를 /obstacles 로 돌려둔다.
       실차 라이다 재생으로 /raw_obstacles 를 직접 낼 때(view.sh)는 /raw_obstacles 로 넘긴다. -->
  <arg name="t_obstacles_topic" default="/obstacles" />
  <arg name="p_obstacles_topic" default="/obstacles" />
  <!-- 2026-09-19: view.sh(실차 라이다 재생)에서 판정 입력별 설정을 넘기려고 노출. 기본값은 parking_and_avoid 와 같음. -->
  <arg name="p_end_check_consec" default="70" />
  <arg name="corridor_half_width" default="0.0" />
  <include file="$(find obstacle_bridge)/launch/parking_and_avoid.launch">
    <arg name="lidar"    value="false" />
    <arg name="detector" value="false" />
    <arg name="t_obstacles_topic" value="$(arg t_obstacles_topic)" />
    <arg name="p_obstacles_topic" value="$(arg p_obstacles_topic)" />
    <arg name="p_end_check_consec" value="$(arg p_end_check_consec)" />
    <arg name="corridor_half_width" value="$(arg corridor_half_width)" />
    <arg name="mount_x"   value="$(arg mount_x)" />
    <arg name="mount_y"   value="$(arg mount_y)" />
    <arg name="mount_yaw" value="$(arg mount_yaw)" />
    <arg name="center_lane" value="$(arg center_lane)" />
    <arg name="left_lane"   value="$(arg left_lane)" />
    <arg name="right_lane"  value="$(arg right_lane)" />
    <arg name="ladder_lanes" value="$(arg ladder_lanes)" />
    <arg name="ladder_extra_step" value="$(arg ladder_extra_step)" />
    <arg name="ladder_csv_dir" value="$(arg ladder_csv_dir)" />
    <arg name="ladder_state" value="$(arg ladder_state)" />
    <arg name="ladder_safety_margin" value="$(arg ladder_safety_margin)" />
    <arg name="p_decide_dist" value="$(arg p_decide_dist)" />
  </include>

  <!-- 경로 추종 오차 / state 진행 / 성공여부 기록.
       2026-09-14: 돌릴 때마다 logs/<타임스탬프>_<label>/ 에 새로 쌓는다
       (예전엔 /tmp/eval_full.csv 하나를 매번 덮어써서 비교가 안 됐고,
       그마저 컨테이너 /tmp 라 호스트에서 안 보였다). label 로 이번
       실행이 뭘 테스트한 건지 구분해서 붙일 것. -->
  <arg name="eval_label" default="full" />
  <node name="eval_metrics" pkg="sim_vehicle" type="eval_metrics.py"
        args="$(arg eval_label)" output="screen" />
</launch>
