<?xml version="1.0"?>
<launch>
  <!-- 2026-09-07: A/B harness for the pure_pursuit lookahead-scaling and
       hybrid_control blend restoration added to waypoint_follower. Runs the
       drift/GPS-dropout profile (sim_vehicle_drift.launch) so results
       reflect the worst-case steering-servo error already characterized
       from the real bag, then logs cross-track error + steer reversals via
       eval_metrics.py. -->
  <arg name="lookahead_curvature_scaling" default="false" />
  <arg name="control_hybrid_enable" default="false" />
  <arg name="run_label" default="baseline" />
  <arg name="eval_out" default="/tmp/eval_$(arg run_label).csv" />
  <arg name="start_rviz" default="false" />

  <include file="$(find sim_vehicle)/launch/sim_vehicle_drift.launch">
    <arg name="start_rviz" value="$(arg start_rviz)" />
  </include>

  <!-- 2026-09-07: must come AFTER the include above. waypoint_follower.launch
       (reached via this include) loads t870_control.yaml via <rosparam>,
       which now defaults control_hybrid_enable to true; since roslaunch
       resolves params in flattened document order, an override placed
       before the include gets clobbered by that later yaml load. Putting
       it here lets this harness still force either mode off for A/B tests. -->
  <param name="/waypoint_follower_node/lookahead_curvature_scaling"
         value="$(arg lookahead_curvature_scaling)" />
  <param name="/waypoint_follower_node/control_hybrid_enable"
         value="$(arg control_hybrid_enable)" />

  <node name="eval_metrics" pkg="sim_vehicle" type="eval_metrics.py"
        args="$(arg eval_out) $(arg run_label)" output="screen" />
</launch>
