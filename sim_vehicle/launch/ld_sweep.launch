<?xml version="1.0"?>
<launch>
  <!-- 2026-09-08: Ld 피팅 전용. sim_vehicle.launch 를 건드리지 않으려고
       필요한 노드만 직접 띄운다. 차이는 셋뿐이다.
         1) rviz 를 안 띄운다. waypoint_loader.launch 는 rviz 를 무조건
            띄우므로 include 하지 않고 loader 노드만 직접 실행한다.
         2) 장애물/주차 판정 스택을 안 띄운다. 측정 구간(state 3)은
            회피도 주차도 없는 구간이라 결과에 영향이 없고, 실행이 빨라진다.
         3) 차량 초기 위치를 0.csv idx 820 으로 준다. 전 구간을 도는 대신
            곡률이 가장 큰 state 3(idx 828~1477, 64.9m)만 달린다.

       measure window 는 후처리에서 인덱스로 자른다(ld_sweep.py). -->

  <arg name="csv_dir" default="$(find sim_vehicle)/../data_시흥/최종/" />

  <!-- 중간에서 출발하므로 로더의 시작 mission_state 를 출발점 state 로 준다.
       로더는 후보를 (현 state) 또는 (현 state + 1) 인 점만 받는다
       (new_waypoint_loader.cpp getClosestWaypoint). 기본 0 으로 두면 state 2
       지점에서 출발했을 때 차이가 2 라 후보가 하나도 안 잡혀 경로에
       영영 붙지 못한다. -->
  <arg name="state_inspection" default="2" />

  <!-- 0.csv idx 820 = state 3 진입 직전. 그 앞 8m 는 속도/조향 정착용. -->
  <arg name="init_x"   default="-68.7033" />
  <arg name="init_y"   default="6.0127" />
  <arg name="init_yaw" default="-1.8264" />

  <!-- 조향 1차지연. alpha = 1 - exp(-dt/tau), dt = 1/50s.
       tau 0.38 -> 0.0511 / 0.55 -> 0.0357 / 0.60 -> 0.0328 -->
  <arg name="steer_lag_alpha" default="0.0357" />

  <!-- Ld = clamp(base + gain * |v|). min/max 는 스윕값을 자르지 않도록 넓게. -->
  <arg name="ld_base" default="3.5" />
  <arg name="ld_gain" default="0.0" />
  <arg name="ld_min"  default="0.3" />
  <arg name="ld_max"  default="30.0" />

  <!-- raw 0~1000. 1000 = 15 km/h = 4.167 m/s -->
  <arg name="speed_override" default="450" />

  <arg name="out" default="/tmp/ld_sweep_run.csv" />

  <node name="waypoint_loader_node" pkg="waypoint_maker"
        type="waypoint_loader_node" output="log">
    <param name="state_inspection" value="$(arg state_inspection)" />
    <param name="parking_count" value="-2" />
    <param name="csv_dir" value="$(arg csv_dir)" />
  </node>

  <node name="fake_vehicle_node" pkg="sim_vehicle" type="fake_vehicle_node.py"
        output="log">
    <param name="init_x"   value="$(arg init_x)" />
    <param name="init_y"   value="$(arg init_y)" />
    <param name="init_yaw" value="$(arg init_yaw)" />
    <param name="steer_lag_alpha" value="$(arg steer_lag_alpha)" />
  </node>

  <include file="$(find autoware_ekf_localizer)/launch/legacy_outputs.launch" />

  <param name="/waypoint_follower_node/p_parking_entry_dist" value="0.5" />
  <param name="/waypoint_follower_node/parking_finish_dist" value="1.0" />
  <rosparam param="/waypoint_follower_node/target_state_lock">[12, 13, 28, 29, 30, 31]</rosparam>

  <include file="$(find waypoint_follower)/launch/waypoint_follower.launch" />

  <!-- yaml 을 덮어써야 하므로 include 뒤에 온다. -->
  <param name="/waypoint_follower_node/control_hybrid_enable" value="false" />
  <param name="/waypoint_follower_node/lookahead_curvature_scaling" value="false" />
  <param name="/waypoint_follower_node/lookahead_state_override" value="true" />
  <param name="/waypoint_follower_node/lookahead_speed_scaling" value="true" />
  <param name="/waypoint_follower_node/lookahead_speed_base" value="$(arg ld_base)" />
  <param name="/waypoint_follower_node/lookahead_speed_gain" value="$(arg ld_gain)" />
  <param name="/waypoint_follower_node/lookahead_speed_min"  value="$(arg ld_min)" />
  <param name="/waypoint_follower_node/lookahead_speed_max"  value="$(arg ld_max)" />
  <param name="/waypoint_follower_node/speed_override" value="$(arg speed_override)" />

  <node name="eval_metrics" pkg="sim_vehicle" type="eval_metrics.py"
        args="$(arg out) ldsweep" output="log" />
</launch>
