<?xml version="1.0"?>
<launch>
  <!-- Hardware-free stand-in for vehicle_bridge + t870_gps + t870_ekf.
       Loads a data_XXX/ csv path, drives it with waypoint_follower against
       a simulated kinematic-bicycle vehicle, and shows it in rviz. -->
  <arg name="csv_dir" default="$(find sim_vehicle)/../data_시흥/최종/" />
  <!-- 2026-09-09 재보정: 15 km/h(0.0041667) 가정이 틀렸다. speed_sweep.bag +
       drift_0906 bag 두 점을 GPS 로 캘리브레이션한 엔코더로 실측:
       raw 350->1.088 m/s, raw 900->2.783 m/s -> v=raw*0.003081, raw1000 외삽
       3.09 m/s(11.1 km/h). fake_vehicle_node.py 의 파이썬 기본값도 이 값으로
       맞춰뒀지만, 이 launch 가 명시적으로 <param> 를 내려써서 그 기본값이
       가려지므로 여기서도 반드시 같이 고쳐야 한다(안 그러면 실제 컨트롤러
       (RAW_TO_MPS=0.003081, waypointFollower.h)와 가짜 차량이 서로 다른
       raw->m/s 로 동작해 speed_curvature_alat 계산이 안 맞는다). -->
  <arg name="speed_scale" default="0.003081"
       doc="m/s per raw cmd_speed unit (0-1000). 실측(2026-09-09): raw 900 = 2.783 m/s." />
  <arg name="max_speed_mps" default="3.09" doc="raw 1000 외삽(11.1 km/h). 실측 기반, 스펙 15km/h 아님." />
  <arg name="max_accel_mps2" default="0.77"
       doc="drive_accel_raw_per_s(250, 2026-09-09 500->250) * speed_scale." />
  <!-- 2026-09-09: GPS 드롭아웃과 무관한 EKF 지연(fake_vehicle_node.py 의
       POS_LAG_* 주석 참고). false 로 끄면 예전처럼 이상적인 위치 피드백을
       그대로 낸다 - 신구 Ld/속도 전략만 순수 비교하고 싶을 때 끈다. -->
  <arg name="pos_lag_enable" default="false" />
  <arg name="start_rviz" default="true" />
  <!-- 2026-09-10: 로더의 current_mission_state_ 초기값. 기본 0은 CSV의 첫
       state 값이 0일 때만 맞다. 국민대 운동장처럼 원본 코스를 조각내 옮긴
       경로는 조각마다 state 가 0이 아닌 값(예: chunk2 는 4)부터 시작하는데,
       state 불일치 상태로는 getClosestWaypoint() 후보가 영원히 0개라
       final_waypoints 창이 인덱스 0에 고정되고 차가 시작 부근을 맴돈다
       (chunk2/3 sim 검증: CTE 중앙값 7m대). 조각 CSV 를 돌릴 땐 그 조각의
       첫 state 값으로 맞춰줘야 한다. -->
  <arg name="state_inspection" default="0" />
  <!-- 2026-09-18: 레인 전환 없이 특정 CSV 단독 주행용(0=0.csv, 1=1.csv). -->
  <arg name="initial_lane" default="0" />
  <arg name="control_config"
       default="$(find waypoint_follower)/config/t870_control.yaml" />
  <arg name="min_final_ld" default="-1" />
  <!-- 2026-09-17: 스폰 위치를 임의 지점으로 바꿀 수 있게 노출한다(기본은
       예전과 동일하게 csv_dir 의 0.csv 첫 줄 = state0 시작점). 특정 구간만
       빠르게 반복 테스트할 때, 그 구간 시작점 좌표 한 줄짜리 CSV 를 만들어
       여기 넘기고 state_inspection 을 그 state 값으로 맞추면 매번 처음부터
       완주하지 않고 바로 그 구간에서 시작한다. -->
  <arg name="init_from_csv" default="$(arg csv_dir)0.csv" />

  <include file="$(find waypoint_maker)/launch/waypoint_loader.launch">
    <arg name="csv_dir" value="$(arg csv_dir)" />
    <arg name="state_inspection" value="$(arg state_inspection)" />
    <arg name="initial_lane" value="$(arg initial_lane)" />
  </include>

  <node name="fake_vehicle_node" pkg="sim_vehicle" type="fake_vehicle_node.py" output="screen">
    <param name="init_from_csv" value="$(arg init_from_csv)" />
    <param name="speed_scale" value="$(arg speed_scale)" />
    <param name="max_speed_mps" value="$(arg max_speed_mps)" />
    <param name="max_accel_mps2" value="$(arg max_accel_mps2)" />
    <param name="pos_lag_enable" value="$(arg pos_lag_enable)" />
  </node>

  <!-- waypoint_maker/obstacle_bridge still consume the pre-EKF-refactor
       /odom_back /odom_front /heading topics; this just republishes
       /odom_fused into those, no hardware involved. -->
  <include file="$(find autoware_ekf_localizer)/launch/legacy_outputs.launch" />

  <!-- 2026-09-07: p_parking_entry_dist default (1.5m) never triggers for our
       synthetic parallel-parking approach geometry; testing a tighter 0.5m
       (matching t_parking_entry_dist's own default) per user request.
       Must be set before waypoint_follower_node starts reading its params. -->
  <param name="/waypoint_follower_node/p_parking_entry_dist" value="0.5" />
  <param name="/waypoint_follower_node/parking_finish_dist" value="1.0" />
  <!-- 2026-09-07: default target_state_lock only locks the CHECK states
       (12, 30), not the ENTRY/reverse states (13, 31), so during reverse
       the pure-pursuit lookahead target can cross the reversal cusp into
       the next (opposite-direction) state once the remaining reverse
       segment is shorter than lookahead_dist_, causing the vehicle to
       orbit a target it's driving away from. Lock 13/31 too so the target
       search stays inside the reverse segment itself.

       2026-09-07: 28 and 29 are locked for the 00.csv-derived 30/31/32.
       That reverse leg (state 31) runs parallel to the approach road and
       only ~3m north of it, and the CHECK leg (30) is just 2.3m long,
       shorter than the approach lookahead (7.0m in state 28, 5.0m in 29).
       So the unlocked target scan skipped the whole CHECK leg and locked
       onto state 31 abeam to the north, asking for 13-26deg of steering
       for the entire approach and dragging the car off the road before it
       ever reached the CHECK corridor. Measured over the approach, the
       longest sustained one-way >15deg pull goes 20 points (2.0m) with
       28/29 unlocked, 15 points with only 29 locked, and 1 point once
       both are locked; the original geometry's baseline was 9 points. -->
  <!-- 2026-09-14: 14(T자 탈출), 32(평행 탈출) 추가. 진입(13/31)만 잠그고
       탈출은 안 잠갔더니 state13->14, 31->32 경계에서 같은 반전-교차
       버그가 재현됐다(사용자 관측: 실주행 중 state14~15 사이 순간 CTE
       급증). t870_control.yaml 도 같이 맞춘다(그쪽은 아예 이 파라미터가
       없어 [12,30]만 잠그는 C++ 기본값으로 실차가 돌고 있었다). -->
  <rosparam param="/waypoint_follower_node/target_state_lock">[12, 13, 14, 28, 29, 30, 31, 32]</rosparam>

  <!-- 2026-09-10: 여태 인자 없이 include 해서 control_config / min_final_ld 를
       sim_full_test 에서 넘겨도 조용히 무시됐다(스윕 7회가 전부 무효였다).
       파라미터를 바꿨으면 로그의 SUMMARY 에서 실제 값을 반드시 확인할 것. -->
  <include file="$(find waypoint_follower)/launch/waypoint_follower.launch">
    <arg name="control_config" value="$(arg control_config)" />
    <arg name="min_final_ld" value="$(arg min_final_ld)" />
  </include>

  <!-- 2026-09-07: t870_control.yaml (loaded by the include above) now
       defaults control_hybrid_enable to true. That override found a real
       regression in the parallel-parking reverse (30->31 cusp curvature
       spike, see t870_control.yaml comment) that hasn't been fixed yet, so
       force PP-only here until it is. Must come AFTER the include above,
       since roslaunch resolves params in flattened document order and the
       yaml's rosparam load would otherwise clobber an earlier override. -->
  <param name="/waypoint_follower_node/control_hybrid_enable" value="false" />

  <!-- waypoint_loader.launch already starts its own unconditional "rviz" node
       (path.rviz, no vehicle marker); ours is named differently so both can
       run side by side without a name clash. -->
  <node if="$(arg start_rviz)" name="sim_vehicle_rviz" pkg="rviz" type="rviz"
        args="-d $(find sim_vehicle)/rviz/sim_vehicle.rviz" />
</launch>
