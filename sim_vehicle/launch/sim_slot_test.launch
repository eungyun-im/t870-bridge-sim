<?xml version="1.0"?>
<launch>
  <!-- 2026-09-08: 빈 주차칸 선택 테스트.
       0.csv = 슬롯 A 로 주차하는 완주 경로 (lane 0)
       1.csv = 슬롯 B 로 주차하는 완주 경로 (lane 1)
       진입로(scan_state)를 달리는 동안 라이다로 두 칸을 보고 빈 칸의
       경로를 고른다. 슬롯 좌표는 각 CSV 의 ENTRY(후진) 끝점이다.

       T자주차: 슬롯 A (-26.377,-50.005) / 슬롯 B (-27.275,-46.846)  간격 3.28m
       평행주차: 슬롯 A (-15.792,-25.541) / 슬롯 B (-9.874,-28.135)  간격 6.46m

       기본은 A 칸을 막아서 B(lane 1)를 고르는지 본다. -->

  <arg name="start_rviz" default="false" />
  <arg name="min_frames" default="10" />
  <arg name="decide_dist" default="7.0" />

  <!-- 어느 주차를 테스트할지: 12=T자, 30=평행 -->
  <arg name="scan_state" default="12" />
  <arg name="done_state" default="13" />
  <arg name="slot_a_x" default="-26.377" />
  <arg name="slot_a_y" default="-50.005" />
  <arg name="slot_b_x" default="-27.275" />
  <arg name="slot_b_y" default="-46.846" />

  <!-- 막을 칸의 장애물. 기본은 슬롯 A 중심. -->
  <arg name="obstacles" default="[-26.377, -50.005, 0.30]" />

  <include file="$(find sim_vehicle)/launch/sim_vehicle.launch">
    <arg name="start_rviz" value="$(arg start_rviz)" />
  </include>

  <node name="fake_obstacles_node" pkg="sim_vehicle" type="fake_obstacles_node.py"
        output="screen">
    <rosparam param="obstacles" subst_value="True">$(arg obstacles)</rosparam>
    <param name="max_range" value="12.0" />
    <param name="odom_topic" value="/odom_fused" />
  </node>

  <node name="parking_slot_selector_node" pkg="obstacle_bridge"
        type="parking_slot_selector_node" output="screen">
    <param name="slot_a_x" value="$(arg slot_a_x)" />
    <param name="slot_a_y" value="$(arg slot_a_y)" />
    <param name="slot_b_x" value="$(arg slot_b_x)" />
    <param name="slot_b_y" value="$(arg slot_b_y)" />
    <param name="slot_radius" value="1.2" />

    <param name="scan_state" value="$(arg scan_state)" />
    <param name="done_state" value="$(arg done_state)" />
    <param name="lane_slot_a" value="0" />
    <param name="lane_slot_b" value="1" />
    <param name="default_slot" value="0" />

    <!-- 2026-09-08: decide_dist 는 "다음 state 까지 남은 거리" 가 이 값
         아래로 내려오면 결정한다는 뜻이다. 진입로보다 길게 잡으면 구간에
         들어서는 순간 이미 조건이 참이라 첫 프레임에 결정해버린다.
         실측: T자 진입로(state 12)는 15.4m 라 7.0 이면 60프레임 넘게 스캔한
         뒤 결정하지만, 평행 진입로(state 30)는 2.2m 뿐이라 1프레임 만에
         기본값으로 떨어졌다. 진입로 길이에 맞춰 준다. -->
    <param name="min_frames" value="$(arg min_frames)" />
    <param name="occupied_ratio" value="0.30" />
    <param name="decide_dist" value="$(arg decide_dist)" />

    <param name="odom_topic" value="/odom_fused" />
    <param name="state_topic" value="gps_state" />
  </node>
</launch>
