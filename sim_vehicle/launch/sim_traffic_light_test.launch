<?xml version="1.0"?>
<launch>
  <!-- 2026-09-16: sim_full_test.launch(S자회피+T자주차+평행주차+정지) 에
       vision_traffic fake publisher 를 얹어, new_process.cpp 에서
       신호등 정지-출발이 걸리는 4곳(state 3/7/15/33, data_시흥 번호 기준)을
       한 런에서 같이 검증한다. sim_full_test.launch 의 모든 인자를
       그대로 통과시키므로 장애물/주차/회피 시나리오는 그쪽과 동일하다.

       실행: roslaunch sim_vehicle sim_traffic_light_test.launch

       새로 추가되는 건 fake_traffic_light_node 하나뿐이고, new_process.cpp
       나 실차 launch 는 전혀 건드리지 않는다(vision_traffic 토픽을
       가짜로 흉내내기만 함) -->

  <arg name="start_rviz" default="false" />
  <arg name="csv_dir" default="$(find sim_vehicle)/../data_시흥/최종/" />
  <arg name="speed_override" default="0" />
  <arg name="parking_speed_override" default="0" />
  <arg name="lookahead_state_override" default="true" />
  <arg name="speed_curvature_alat" default="0.5" />
  <arg name="speed_curvature_preview" default="3.0" />
  <arg name="speed_curvature_min_raw" default="150" />
  <arg name="speed_cte_gain" default="1.0" />
  <arg name="pos_lag_enable" default="false" />
  <arg name="stop_obstacle" default="false" />
  <arg name="state_inspection" default="0" />
  <arg name="control_config"
       default="$(find waypoint_follower)/config/t870_control.yaml" />
  <arg name="min_final_ld" default="-1" />
  <arg name="eval_label" default="traffic_light" />

  <!-- 신호등 걸리는 4곳: state 3/7/15 는 dist<=6.0 부터 3단계 감속,
       33 은 dist<=3.7 에서 바로 판단(new_process.cpp 와 동일). -->
  <arg name="tl_target_states" default="[3, 7, 15, 33]" />
  <arg name="tl_red_duration" default="5.0"
       doc="빨간불 유지 시간(초). 이 시간 동안 정지가 유지되는지 보고,
            지난 뒤 실제로 재출발하는지 본다." />

  <include file="$(find sim_vehicle)/launch/sim_full_test.launch">
    <arg name="start_rviz" value="$(arg start_rviz)" />
    <arg name="csv_dir" value="$(arg csv_dir)" />
    <arg name="speed_override" value="$(arg speed_override)" />
    <arg name="parking_speed_override" value="$(arg parking_speed_override)" />
    <arg name="lookahead_state_override" value="$(arg lookahead_state_override)" />
    <arg name="speed_curvature_alat" value="$(arg speed_curvature_alat)" />
    <arg name="speed_curvature_preview" value="$(arg speed_curvature_preview)" />
    <arg name="speed_curvature_min_raw" value="$(arg speed_curvature_min_raw)" />
    <arg name="speed_cte_gain" value="$(arg speed_cte_gain)" />
    <arg name="pos_lag_enable" value="$(arg pos_lag_enable)" />
    <arg name="stop_obstacle" value="$(arg stop_obstacle)" />
    <arg name="state_inspection" value="$(arg state_inspection)" />
    <arg name="control_config" value="$(arg control_config)" />
    <arg name="min_final_ld" value="$(arg min_final_ld)" />
    <arg name="eval_label" value="$(arg eval_label)" />
  </include>

  <node name="fake_traffic_light_node" pkg="sim_vehicle" type="fake_traffic_light_node.py"
        output="screen">
    <rosparam param="target_states" subst_value="True">$(arg tl_target_states)</rosparam>
    <param name="red_duration" value="$(arg tl_red_duration)" />
    <param name="state_topic" value="gps_state" />
  </node>
</launch>
